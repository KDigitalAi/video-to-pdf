# Vimeo API Configuration
# Get your token from: https://developer.vimeo.com/apps
VIMEO_TOKEN=your_vimeo_token_here

# OpenAI (optional smart summarization after subtitle cleaning)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Set to false to disable AI summarization (Stage 2); rule-based filter still runs
USE_AI_SUMMARIZER=true
